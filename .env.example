# Unusual Whales API key — https://unusualwhales.com/dashboard/api
UW_API_KEY=

# --- API budget (re-read on every run; edit anytime) ---
# Your UW plan's daily request limit (Basic = 40000). Resets 8 PM ET.
WHALEPROOF_DAILY_LIMIT=40000
# Requests the overnight backfill must leave untouched for daytime scans / your own use.
WHALEPROOF_BACKFILL_RESERVE=12000
# Backfill never runs between this time and the 20:00 ET reset.
WHALEPROOF_BACKFILL_STOP=07:00
# adaptive (default): backfill uses whatever live jobs won't need before the 8 PM reset; night: fixed cap + quiet hours
WHALEPROOF_BACKFILL_MODE=adaptive
# Extra requests always kept free (adaptive mode)
WHALEPROOF_SAFETY=1500
# Intraday feed: auto (off until history backfill is complete), on, off
WHALEPROOF_INTRADAY=auto
# Optional hard ceiling for the adaptive backfill (e.g. 35000 keeps 5000 free)
WHALEPROOF_BACKFILL_MAX=35000
